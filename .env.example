# --- Backend ---
DATABASE_URL=postgresql+asyncpg://nevermiss:nevermiss@postgres:5432/nevermiss
REDIS_URL=redis://redis:6379/0
CHROMA_URL=http://chromadb:8000

LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1

GROQ_API_KEY=your_groq_api_key

STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo

TTS_PROVIDER=groq
TTS_MODEL=canopylabs/orpheus-v1-english

SUPPORTED_LANGUAGES=["en","ar"]
DEFAULT_LANGUAGE=en
LANGUAGE_DETECTION=true

CALL_TRANSPORT=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

NGROK_AUTHTOKEN=
PUBLIC_BASE_URL=

CLERK_SECRET_KEY=
CLERK_JWKS_URL=

ENV=dev

# --- Postgres (used by docker-compose to init the db) ---
POSTGRES_USER=nevermiss
POSTGRES_PASSWORD=nevermiss
POSTGRES_DB=nevermiss

# --- Frontend (Next.js, must be prefixed NEXT_PUBLIC_ to reach the browser) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8010
NEXT_PUBLIC_WS_URL=ws://localhost:8010
